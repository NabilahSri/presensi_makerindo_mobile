#!/usr/bin/env bash
# Enforce Conventional Commits and forbid AI attribution trailers (Mobile).
set -euo pipefail

msg_file="$1"
first_line=$(head -n1 "$msg_file" | tr -d '\r')

if echo "$first_line" | grep -qE '^(Merge |Revert |fixup! |squash! )'; then
  exit 0
fi

pattern='^(feat|fix|refactor|style|test|docs|chore|ci|perf|build)(\([a-z0-9._/-]+\))?!?: .{3,}$'
if ! echo "$first_line" | grep -qE "$pattern"; then
  echo "✖ Pesan commit harus mengikuti format Conventional Commits:" >&2
  echo "    tipe(scope): deskripsi   mis. feat(mobile): validasi foto saat check-out" >&2
  echo "    tipe valid: feat|fix|refactor|style|test|docs|chore|ci|perf|build" >&2
  exit 1
fi

if [ ${#first_line} -gt 100 ]; then
  echo "✖ Baris pertama pesan commit maksimal 100 karakter." >&2
  exit 1
fi

if grep -qiE '^(Co-Authored-By:.*(claude|gemini|copilot|chatgpt|openai|anthropic)|Generated (with|by) )' "$msg_file"; then
  echo "✖ Tanpa atribusi AI di pesan commit (aturan proyek)." >&2
  exit 1
fi

exit 0
