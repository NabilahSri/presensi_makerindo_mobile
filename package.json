{
  "name": "presensi-makerindo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo workspace for Presensi Makerindo — Laravel 13 Web Portal & REST API (main) and Flutter Mobile Client (branch mobile)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "setup": "composer --working-dir=apps/server run setup",
    "dev": "npm run dev --workspace=apps/server",
    "dev:server": "composer --working-dir=apps/server run dev",
    "serve": "php apps/server/artisan serve",
    "build": "npm run build --workspace=apps/server",
    "test": "composer --working-dir=apps/server run test",
    "lint": "composer --working-dir=apps/server exec pint -- --test",
    "lint:fix": "composer --working-dir=apps/server exec pint"
  }
}
